# 环境变量示例（复制为 .env 后填入你自己的密钥）
#
# ⚠️ 密钥纪律（比赛红线）：
#   1. 本文件只用于**示例**，**不要把填了真实密钥的 .env 提交到任何仓库**；
#   2. 云部署（Netlify）请在**平台的环境变量设置**里配置，不要放到代码或文件里；
#   3. 客户端代码、公开仓库、测试日志、截图里**不得出现密钥明文**。

# 检索通道：博查（中文检索，带来源日期）
BOCHA_API_KEY=

# 检索通道：Tavily（权威源命中强，可作交叉核验）
TAVILY_API_KEY=

# 可选：大模型（当前核心链路为"确定性组装"，不依赖大模型即可运行；
#       预留用于后续的自然语言润色或意图增强）
DEEPSEEK_API_KEY=
